{
  "name": "@nowcore/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "tags": [
      "scope:web",
      "type:app"
    ],
    "targets": {
      "dev": {
        "dependsOn": [
          "^build"
        ],
        "options": {
          "port": 3000
        }
      },
      "build": {
        "options": {
          "env": {
            "NEXT_DIST_DIR": ".next-build"
          }
        },
        "outputs": [
          "{projectRoot}/.next-build"
        ]
      },
      "budget": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node budget.mjs",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "production",
          "^production"
        ],
        "cache": true
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit -p tsconfig.json",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "cache": true
      }
    }
  },
  "dependencies": {
    "@nowcore/shared": "workspace:^",
    "@nowcore/ui": "workspace:^",
    "geist": "^1",
    "next": "~16.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
