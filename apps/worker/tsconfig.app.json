{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "emitDeclarationOnly": false,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../../libs/shared/tsconfig.lib.json"
    },
    {
      "path": "../../libs/pod/tsconfig.lib.json"
    },
    {
      "path": "../../libs/orders/tsconfig.lib.json"
    },
    {
      "path": "../../libs/db/tsconfig.lib.json"
    },
    {
      "path": "../../libs/storage/tsconfig.lib.json"
    }
  ],
  "exclude": ["src/**/*.spec.ts", "vitest.config.mts"]
}
