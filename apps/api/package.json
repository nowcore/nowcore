{
  "name": "@nowcore/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "name": "api",
    "tags": [
      "scope:server",
      "type:app"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/dist"
        ],
        "options": {
          "command": "tsc --build tsconfig.app.json",
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ]
      },
      "serve": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "continuous": true,
        "options": {
          "command": "node dist/main.js",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "fastify": "5.11.3"
  },
  "dependencies": {
    "@nestjs/common": "^11",
    "@nestjs/core": "^11",
    "@nestjs/platform-fastify": "^11",
    "@nowcore/db": "workspace:^",
    "@prisma/adapter-pg": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0",
    "zod": "4.4.3"
  }
}
