{
  "name": "nowcore",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": ">=9"
  },
  "scripts": {
    "dev": "nx run-many -t dev serve --parallel=4",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "check": "nx run-many -t typecheck lint test build",
    "affected": "nx affected -t typecheck lint test",
    "graph": "nx graph",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "tools/compose.sh up -d --wait",
    "infra:down": "tools/compose.sh down",
    "infra:reset": "tools/compose.sh down -v && pnpm infra:up",
    "db:migrate": "nx run db:migrate",
    "db:seed": "nx run db:seed",
    "motion-check": "node tools/motion-check.mjs",
    "frames": "nx run worker:render-seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/playwright": "23.1.1",
    "@nx/vitest": "23.1.1",
    "@playwright/test": "^1.62.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jsdom": "^30.0.1",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^1.5.11",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  }
}
